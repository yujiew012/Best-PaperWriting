%% floatcheck.sty -- record float / first-reference positions for check_layout.py
%%
%% Usage (pick one):
%%   1. Add \usepackage{floatcheck} as the LAST package in the preamble, or
%%   2. Leave the source untouched and build a diagnostic run:
%%        pdflatex -jobname=main "\RequirePackage{floatcheck}\input{main}"
%% Then run:
%%   python3 check_layout.py main.aux
%%
%% Copy this file next to main.tex (or put its directory on TEXINPUTS).
%%
%% What is written to the .aux file (all lengths in sp, y measured from the
%% bottom of the page, as reported by \pdfsavepos / \savepos):
%%   \FCgeom{twocolumn}{twoside}{oddleft}{evenleft}{columnwidth}{columnsep}
%%   \FCdef{seq}{type}{starred}{page}{physpage}{x}{y}    where \begin{<float>} is in the text
%%   \FCfloat{label}{seq}{type}{starred}{page}{physpage}{x}{y}   where the float was placed
%%   \FCref{labels}{page}{physpage}{x}{y}                each \ref-like call in running text
%%   \FCmark{what}{page}{physpage}{x}{y}                 start of the bibliography / appendix
%%   \FCblock{top}{bottom}                               text block top and bottom (y from page bottom)
%%
%% The package only adds whatsits (no boxes, glue or penalties), so the layout
%% is the same as a normal build.
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{floatcheck}[2026/11/27 v1.1 float placement recorder for check_layout.py]
\RequirePackage{letltxmacro}

% ---- position primitives (pdfTeX / XeTeX: \pdfsavepos, LuaTeX: \savepos) ----
\ifdefined\pdfsavepos
  \let\FC@savepos\pdfsavepos \let\FC@lastx\pdflastxpos \let\FC@lasty\pdflastypos
\else\ifdefined\savepos
  \let\FC@savepos\savepos \let\FC@lastx\lastxpos \let\FC@lasty\lastypos
\else
  \PackageWarningNoLine{floatcheck}{No \string\pdfsavepos/\string\savepos:
    only page numbers will be recorded}
  \let\FC@savepos\relax \chardef\FC@zero=0
  \let\FC@lastx\FC@zero \let\FC@lasty\FC@zero
\fi\fi

% #1 = "\string\FCxxx{..}{..}" prefix; page, physical page and x/y are appended
% and expanded only at shipout, when the final position is known.
\newcommand\FC@write[1]{%
  \@bsphack
  \FC@savepos
  \protected@write\@auxout{}{#1{\thepage}%
    {\noexpand\the\ReadonlyShipoutCounter}%
    {\noexpand\the\FC@lastx}{\noexpand\the\FC@lasty}}%
  \@esphack}

% ---- float definitions (position in the running text) ----
\newcount\FC@seq
\gdef\FC@cur{0}
\gdef\FC@star{0}
\newcommand\FC@floatbefore[2]{%
  \global\advance\FC@seq\@ne
  \xdef\FC@cur{\the\FC@seq}%
  \gdef\FC@star{#2}%
  \FC@write{\string\FCdef{\the\FC@seq}{#1}{#2}}}
\AddToHook{env/figure/before}{\FC@floatbefore{figure}{0}}
\AddToHook{env/table/before}{\FC@floatbefore{table}{0}}
\AddToHook{env/figure*/before}{\FC@floatbefore{figure}{1}}
\AddToHook{env/table*/before}{\FC@floatbefore{table}{1}}

% ---- labels inside floats (position where the float was placed) ----
\newcommand\FC@labelhook[1]{%
  \@ifundefined{@captype}{}{%
    \FC@write{\string\FCfloat{#1}{\FC@cur}{\@captype}{\FC@star}}}}

% ---- references in running text (references inside floats are ignored) ----
% Copy a command faithfully: \DeclareCommandCopy (LaTeX 2022-06+) also handles
% \NewDocumentCommand-style commands such as the kernel's \ref since 2023.
\@ifundefined{DeclareCommandCopy}{\let\FC@copy\LetLtxMacro}{\let\FC@copy\DeclareCommandCopy}
\newcommand\FC@recordref[1]{%
  \@ifundefined{@captype}{\FC@write{\string\FCref{#1}}}{}}
\def\FC@ref@plain#1#2{\FC@recordref{#2}\csname FC@orig@#1\endcsname{#2}}
\def\FC@ref@star#1#2{\FC@recordref{#2}\csname FC@orig@#1\endcsname*{#2}}
% The wrappers are \protected (robust) and use fresh names, so internal names
% of the original commands (e.g. "\ref " / "\ref code") are never touched.
\newcommand\FC@wrapref[1]{%
  \@ifundefined{#1}{}{%
    \expandafter\FC@copy\csname FC@orig@#1\expandafter\endcsname
      \csname #1\endcsname
    \expandafter\protected\expandafter\def\csname #1\endcsname{%
      \@ifstar{\FC@ref@star{#1}}{\FC@ref@plain{#1}}}}}

% ---- labels: use the kernel "label" hook (LaTeX 2023-06+) when available ----
\@ifundefined{AddToHookWithArguments}{\let\FC@labelviahook\@secondoftwo}{%
  \IfHookExistsTF{label}{\let\FC@labelviahook\@firstoftwo}{\let\FC@labelviahook\@secondoftwo}}
\FC@labelviahook{\AddToHookWithArguments{label}{\FC@labelhook{#1}}}{}

% Patch after hyperref / cleveref / nameref have installed their versions.
\AddToHook{begindocument/end}{%
  \FC@labelviahook{}{%
    \FC@copy\FC@orig@label\label
    \@ifpackageloaded{cleveref}%
      {\protected\def\label{\@ifnextchar[\FC@label@opt\FC@label@plain}}%
      {\protected\def\label{\FC@label@plain}}}%
  \@for\FC@tmp:=ref,autoref,cref,Cref,labelcref,vref,Vref\do{%
    \expandafter\FC@wrapref\expandafter{\FC@tmp}}%
  \if@filesw
    \immediate\write\@auxout{\string\providecommand\string\FCgeom[6]{}}%
    \immediate\write\@auxout{\string\providecommand\string\FCdef[7]{}}%
    \immediate\write\@auxout{\string\providecommand\string\FCfloat[8]{}}%
    \immediate\write\@auxout{\string\providecommand\string\FCref[5]{}}%
    \immediate\write\@auxout{\string\providecommand\string\FCmark[5]{}}%
    \immediate\write\@auxout{\string\providecommand\string\FCblock[2]{}}%
    \immediate\write\@auxout{\string\FCblock
      {\number\dimexpr \paperheight-1in-\voffset-\topmargin-\headheight-\headsep\relax}%
      {\number\dimexpr \paperheight-1in-\voffset-\topmargin-\headheight-\headsep-\textheight\relax}}%
    \immediate\write\@auxout{\string\FCgeom
      {\if@twocolumn 1\else 0\fi}{\if@twoside 1\else 0\fi}%
      {\number\dimexpr 1in+\hoffset+\oddsidemargin\relax}%
      {\number\dimexpr 1in+\hoffset+\evensidemargin\relax}%
      {\number\columnwidth}{\number\columnsep}}%
  \fi}
% Classes that switch to two columns after the front matter (Elsevier cas-dc calls \twocolumn in
% \maketitle) are one-column at \begin{document}: record the geometry again at the end, where it is
% two-column. check_layout.py uses the last \FCgeom record.
\AddToHook{enddocument}{%
  \if@filesw\if@twocolumn
    \immediate\write\@auxout{\string\FCgeom
      {1}{\if@twoside 1\else 0\fi}%
      {\number\dimexpr 1in+\hoffset+\oddsidemargin\relax}%
      {\number\dimexpr 1in+\hoffset+\evensidemargin\relax}%
      {\number\columnwidth}{\number\columnsep}}%
  \fi\fi}
% ---- where the main body ends (for page budgets) ----
\AddToHook{env/thebibliography/begin}{\FC@write{\string\FCmark{bibliography}}}
\AddToHook{cmd/printbibliography/before}{\FC@write{\string\FCmark{bibliography}}}
\AddToHook{cmd/appendix/before}{\FC@write{\string\FCmark{appendix}}}
\def\FC@label@opt[#1]#2{\FC@orig@label[#1]{#2}\FC@labelhook{#2}}
\def\FC@label@plain#1{\FC@orig@label{#1}\FC@labelhook{#1}}

\endinput
