{
  "domain": "llm_agent_security",
  "notes": "LLM/agent security figures show where untrusted content enters the model's context: trust boundaries as dashed groups, attacker-controlled inputs in the adverse colour, the defense as the emphasised core.",
  "base": {
    "layout": "threat_model",
    "font": {
      "block_title": 8,
      "block_sub": 6.8,
      "group_title": 8,
      "edge_label": 6.8,
      "badge": 7
    },
    "stroke": {
      "block": 1.1,
      "group": 1.0,
      "arrow": 1.1,
      "core_emphasis": 1.3
    },
    "block": {
      "corner": 0.08,
      "fill": "light"
    },
    "group": {
      "line": "dashed",
      "fill": true
    },
    "badge": {
      "color": "vermilion",
      "size": 11
    },
    "roles": {
      "core": "blue",
      "support": "bluish_green",
      "adverse": "vermilion",
      "neutral": "grey"
    },
    "edge": {
      "label_box": true
    },
    "max_label_words": 4
  },
  "provisional": {
    "max_label_words": {
      "value": 6,
      "rule": "S-0001"
    }
  }
}
