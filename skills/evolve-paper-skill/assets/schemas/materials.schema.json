{
  "$comment": "Output of the Extractor. Structured facts only -- no copied prose. 'source_meta' is stripped before the Writer sees the file.",
  "type": "object",
  "required": [
    "paper_id",
    "domain",
    "problem",
    "idea",
    "experiments",
    "terms"
  ],
  "properties": {
    "paper_id": {
      "type": "string"
    },
    "source_meta": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "venue": {
          "type": "string"
        },
        "year": {
          "type": "string"
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "id",
        "venue_type"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "venue_type": {
          "enum": [
            "conference",
            "journal"
          ]
        },
        "venue_family": {
          "type": "string"
        },
        "template_style": {
          "type": "string"
        }
      }
    },
    "working_topic": {
      "type": "string"
    },
    "problem": {
      "type": "object",
      "required": [
        "setting",
        "gap",
        "challenges"
      ],
      "properties": {
        "setting": {
          "type": "string",
          "minLength": 1
        },
        "gap": {
          "type": "string",
          "minLength": 1
        },
        "motivating_example": {
          "type": "string"
        },
        "challenges": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "statement"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "real_world_case": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "threat_model": {
      "type": "object"
    },
    "idea": {
      "type": "object",
      "required": [
        "core_insight",
        "method_name",
        "components"
      ],
      "properties": {
        "core_insight": {
          "type": "string",
          "minLength": 1
        },
        "method_name": {
          "type": "string",
          "minLength": 1
        },
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "name",
              "addresses",
              "mechanism"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "addresses": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "intuition": {
                "type": "string"
              },
              "mechanism": {
                "type": "string",
                "minLength": 1
              },
              "equations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        },
        "algorithm_steps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "claim",
              "assumptions"
            ],
            "properties": {
              "claim": {
                "type": "string",
                "minLength": 1
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "proof_idea": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "related_work": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "category",
          "works",
          "shared_limitation"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "shared_limitation": {
            "type": "string",
            "minLength": 1
          },
          "works": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "label",
                "approach"
              ],
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "approach": {
                  "type": "string",
                  "minLength": 1
                },
                "limitation": {
                  "type": "string"
                },
                "bibtex": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
    "experiments": {
      "type": "object",
      "required": [
        "setup",
        "results"
      ],
      "properties": {
        "research_questions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "setup": {
          "type": "object",
          "required": [
            "datasets",
            "baselines",
            "metrics"
          ],
          "properties": {
            "datasets": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "metrics": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "implementation": {
              "type": "string"
            },
            "baselines": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "mechanism"
                ],
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1
                  },
                  "mechanism": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        },
        "results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "kind",
              "columns",
              "rows"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "main",
                  "ablation",
                  "sensitivity",
                  "convergence",
                  "scalability",
                  "robustness",
                  "overhead",
                  "case_study",
                  "other"
                ]
              },
              "description": {
                "type": "string"
              },
              "columns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "rows": {
                "type": "array",
                "items": {
                  "type": "array"
                }
              },
              "unit": {
                "type": "string"
              },
              "higher_is_better": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "content"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "type": "string",
            "minLength": 1
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "terms": {
      "type": "object",
      "required": [
        "method_names",
        "component_names"
      ],
      "properties": {
        "method_names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "component_names": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "other_identifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}