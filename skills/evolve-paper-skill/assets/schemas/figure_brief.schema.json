{
  "$comment": "Output of the figure Extractor: WHAT the original figure communicates, never HOW it looks. No spatial, colour or styling words (checked by evolve.py check-brief). 'source' locates the original for cropping and is removed before the Illustrator sees the brief.",
  "type": "object",
  "required": [
    "paper_id",
    "figure_id",
    "domain_id",
    "figure_type",
    "purpose",
    "entities",
    "relations",
    "source",
    "terms"
  ],
  "properties": {
    "paper_id": {
      "type": "string",
      "minLength": 1
    },
    "figure_id": {
      "type": "string",
      "minLength": 1
    },
    "domain_id": {
      "type": "string",
      "minLength": 1
    },
    "figure_type": {
      "enum": [
        "architecture",
        "overview",
        "threat_model",
        "pipeline",
        "system",
        "workflow"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "entities": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "role"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "actor",
              "attacker",
              "component",
              "model",
              "data",
              "store",
              "service",
              "process",
              "output",
              "other"
            ]
          },
          "role": {
            "enum": [
              "core",
              "support",
              "adverse",
              "neutral"
            ]
          }
        }
      }
    },
    "relations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "meaning",
          "kind"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "meaning": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "data_flow",
              "control",
              "attack",
              "feedback",
              "uses",
              "produces"
            ]
          },
          "step": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "members",
          "meaning"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "members": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "meaning": {
            "enum": [
              "trust_boundary",
              "party",
              "stage",
              "layer",
              "subsystem"
            ]
          }
        }
      }
    },
    "emphasis": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "must_show": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "source": {
      "type": "object",
      "required": [
        "page",
        "bbox"
      ],
      "properties": {
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "figure_number": {
          "type": "string"
        }
      }
    },
    "terms": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "$comment": "paper-specific names (method, system, dataset, benchmark) shown in the figure; never allowed in skill rules"
    }
  }
}
